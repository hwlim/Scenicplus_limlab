#!/usr/bin/env bash
# Rejects AI-assistant authorship/attribution in commits, code and PRs.
#
# Git hooks (mode picked by the name it's installed under):
#   commit-msg  commit message + author/committer identity
#   pre-commit  added lines in the staged diff (code comments, docs, ...)
#   pre-push    both of the above for every commit being pushed
#               (catches --no-verify, cherry-picks and rebases)
# CI (mode as first argument):
#   ai-attribution-hook ci BASE HEAD
#               commits and net diff in BASE...HEAD, plus PR_TITLE, PR_BODY
#               and PR_AUTHOR from the environment when set
#
# Local install, with this file committed at .githooks/ai-attribution-hook:
#   for h in commit-msg pre-commit pre-push; do
#     cp .githooks/ai-attribution-hook .git/hooks/$h && chmod +x .git/hooks/$h
#   done
# (If the repo uses core.hooksPath / husky, copy into that dir instead.)

# All patterns are case-insensitive ERE.
TOOLS='github copilot|copilot|chatgpt|gpt-?[0-9]|codex|gemini|cursor (ai|agent|ide)|aider|devin ai|windsurf|codeium|tabnine|amazon q|codewhisperer'

# Matched against commit messages, PR descriptions AND added lines of code.
ATTR_PATTERNS=(
  # "Generated with [Claude Code](...)", "// generated by Copilot"
  "generated (with|by|using) (the help of )?\\[?(claude|$TOOLS)"
  # "written with ChatGPT" -- bare "claude" left out so "Written by Claude Dupont" passes
  "(written|created|authored|co-?authored|assisted|produced) (with|by|using) (the help of )?\\[?(claude code|$TOOLS)"
  'claude\.(ai|com)/(code|claude-code)'
)

# Matched against commit messages and PR descriptions only.
TRAILER_PATTERNS=(
  # Attribution trailers whose value names an AI tool or vendor address
  '^[[:space:]]*(co-authored-by|assisted-by|generated-by|made-with)[[:space:]]*:.*(@anthropic\.com|@cursor\.com|copilot|cursor|chatgpt|codex|gemini|aider|devin-ai|google-labs-jules|windsurf|codeium|tabnine|codewhisperer|amazon q)'
  # "Claude <...>", "Claude Opus 4.1 <...>" with any email (not Jean-Claude, Claude Monet)
  '^[[:space:]]*(co-authored-by|assisted-by|generated-by)[[:space:]]*:[[:space:]]*claude([[:space:]]+(code|opus|sonnet|haiku|fable|mythos)[^<]*)?[[:space:]]*<'
  # aider's message prefix (attribute-commit-message)
  '^aider: '
)

# Matched against "Name <email>" of commit author and committer.
IDENT_PATTERNS=(
  'noreply@anthropic\.com'
  'cursoragent@cursor\.com'
  '\(aider\)'
  '(copilot|copilot-swe-agent|devin-ai-integration|google-labs-jules|chatgpt-codex-connector)(\[bot\])?@users\.noreply\.github\.com'
  '^claude([[:space:]]+(code|opus|sonnet|haiku|fable|mythos)[^<]*)?[[:space:]]*<'
)

# Matched against the GitHub login that opened the PR.
LOGIN_PATTERN='^(copilot|copilot-swe-agent\[bot\]|claude\[bot\]|cursor\[bot\]|devin-ai-integration\[bot\]|google-labs-jules\[bot\]|chatgpt-codex-connector\[bot\])$'

# Files never scanned for code attribution (this script contains the patterns).
PATHSPEC=( -- . ':(exclude,glob)**/ai-attribution-hook*' )
DIFF_OPTS=( -U0 --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ )

violations=()

grep_into() {  # $1 label, $2 text, rest: patterns
  local label=$1 text=$2 p m
  shift 2
  for p in "$@"; do
    while IFS= read -r m; do
      [ -n "$m" ] && violations+=("$label: $m")
    done <<<"$(printf '%s\n' "$text" | tr -d '\r' | grep -Ei -- "$p" | head -n 10)"
  done
}

check_msg() {  # $1 label, $2 message, $3 author ident, $4 committer ident
  local role ident p
  grep_into "$1" "$2" "${TRAILER_PATTERNS[@]}" "${ATTR_PATTERNS[@]}"
  for role in author committer; do
    if [ "$role" = author ]; then ident=$3; else ident=$4; fi
    for p in "${IDENT_PATTERNS[@]}"; do
      if printf '%s\n' "$ident" | grep -Eqi -- "$p"; then
        violations+=("$1: $role is ${ident%%>*}>")
        break
      fi
    done
  done
}

check_diff() {  # $1 label, $2 unified diff; scans added lines only
  local added
  added=$(printf '%s\n' "$2" | awk '
    /^diff --git /    { hdr = 1; next }
    hdr && /^\+\+\+ / { f = substr($0, 7); hdr = 0; next }
    /^@@/             { hdr = 0; next }
    !hdr && /^\+/     { print f ": " substr($0, 2) }')
  [ -n "$added" ] && grep_into "$1" "$added" "${ATTR_PATTERNS[@]}"
}

check_commit() {  # $1 sha
  local h a cm body
  { read -r h; read -r a; read -r cm; body=$(cat); } \
    <<<"$(git log -1 --format='%h%n%an <%ae>%n%cn <%ce>%n%B' "$1")"
  check_msg "$h" "$body" "$a" "$cm"
  check_diff "$h" "$(git diff-tree -p --root "${DIFF_OPTS[@]}" "$1" "${PATHSPEC[@]}")"
}

mode=$(basename "$0")
case "$mode" in
  commit-msg|pre-commit|pre-push) ;;
  *) mode=${1:-}; [ $# -gt 0 ] && shift ;;
esac

case "$mode" in
  commit-msg)
    # The hook sees the raw message: drop comment lines and the `commit -v`
    # diff below the scissors line so code in the diff can't trigger a match.
    cc=$(git config --get core.commentChar 2>/dev/null)
    case "$cc" in ""|auto) cc='#' ;; esac
    msg=$(awk -v c="$cc" '
      index($0, c " ------------------------ >8 ------------------------") == 1 { exit }
      index($0, c) == 1 { next }
      { print }' "$1")
    check_msg "commit" "$msg" "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"
    ;;
  pre-commit)
    check_diff "staged" "$(git diff --cached "${DIFF_OPTS[@]}" "${PATHSPEC[@]}")"
    ;;
  pre-push)
    zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
    while read -r local_ref local_sha remote_ref remote_sha; do
      [ "$local_sha" = "$zero" ] && continue                 # branch deletion
      if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"                   # new branch
      else
        range="$remote_sha..$local_sha"
      fi
      for c in $(git rev-list $range); do check_commit "$c"; done
    done
    ;;
  ci)
    base=${1:-} head=${2:-}
    if [ -z "$base" ] || [ -z "$head" ]; then
      echo "usage: ai-attribution-hook ci BASE HEAD" >&2; exit 2
    fi
    for c in $(git rev-list "$base..$head"); do
      { read -r h; read -r a; read -r cm; body=$(cat); } \
        <<<"$(git log -1 --format='%h%n%an <%ae>%n%cn <%ce>%n%B' "$c")"
      check_msg "$h" "$body" "$a" "$cm"
    done
    check_diff "diff" "$(git diff "${DIFF_OPTS[@]}" "$base...$head" "${PATHSPEC[@]}")"
    if [ -n "${PR_TITLE:-}${PR_BODY:-}" ]; then
      grep_into "PR description" "${PR_TITLE:-}"$'\n'"${PR_BODY:-}" \
        "${TRAILER_PATTERNS[@]}" "${ATTR_PATTERNS[@]}"
    fi
    if [ -n "${PR_AUTHOR:-}" ] && printf '%s\n' "$PR_AUTHOR" | grep -Eqi -- "$LOGIN_PATTERN"; then
      violations+=("PR: opened by $PR_AUTHOR")
    fi
    ;;
  *)
    echo "ai-attribution-hook: install as commit-msg, pre-commit or pre-push, or run: ai-attribution-hook ci BASE HEAD" >&2
    exit 2
    ;;
esac

if [ ${#violations[@]} -gt 0 ]; then
  echo "Rejected: AI-assistant attribution found" >&2
  printf '  %s\n' "${violations[@]}" | awk '!seen[$0]++' >&2
  exit 1
fi
exit 0
